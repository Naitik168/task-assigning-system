# For running the API directly with `cargo run` (outside Docker).
# Start only the infrastructure first:  docker compose up -d postgres redis
APP_ENV=development
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://taskmgr:taskmgr@localhost:5432/taskmgr
# Leave empty to use the in-memory cache instead of Redis
REDIS_URL=redis://localhost:6379
RUN_MIGRATIONS=true

JWT_SECRET=dev-only-jwt-secret-change-me-please-0123456789
JWT_TTL_MINUTES=60
OTP_SECRET=dev-only-otp-secret-change-me-please-0123456789
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
CACHE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_PASSWORD=Bond@007007

RUST_LOG=task_manager_api=info,tower_http=info
# Only for `cargo test` against Redis (optional)
# TEST_REDIS_URL=redis://localhost:6379
